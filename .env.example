# AdeStay environment variables (docs/DEPLOYMENT_AND_OPERATIONS.md §2).
# Copy to .env.local for local development and fill in values. NEVER commit real values:
# .env* files are gitignored (except this example). On Vercel, set these in Project Settings.
#
# NEXT_PUBLIC_* values are sent to browsers. Everything else stays on the server.

# --- Supabase (required) -------------------------------------------------------------
# Project URL, e.g. https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key: public by design, row level security protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service role / secret key: SERVER ONLY. Bypasses row level security. Only modules in
# SERVICE_ROLE_ALLOWLIST (eslint.config.mjs) may read it. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Hosts ------------------------------------------------------------------------------
# Staff/platform host once the root domain exists (D-1), e.g. app.adestay.com. Optional:
# localhost and Vercel's own deployment hostnames are recognised automatically.
NEXT_PUBLIC_APP_HOST=
# Root domain for hostel subdomains (D-1), e.g. adestay.com. Not used yet.
NEXT_PUBLIC_PLATFORM_ROOT_DOMAIN=
# Set to "off" to disable /sites/{slug} hostel previews on the app host. Always off in production.
ADESTAY_TENANT_PREVIEW=

# --- Later phases (leave empty until the related decision/phase) -----------------------
# Bearer token for /api/cron/* (Phase 3+).
CRON_SECRET=
# Vercel Domains API for custom hostel domains (Phase 2), scoped token.
VERCEL_API_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
# Transactional email provider (D-9).
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM_DOMAIN=
# SMS provider (D-10, Phase 6).
SMS_PROVIDER_API_KEY=
SMS_SENDER_ID=
# Bot protection on public forms, only if D-11 is approved.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Secret for hashing IP addresses (booking lookup rate limit, audit logs). SERVER ONLY, 16+
# characters. Booking lookup stays unavailable until it is set.
LOG_REDACTION_SALT=
# Error monitoring, only if D-17 is approved.
SENTRY_DSN=
